{
  "name": "riglab",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Art-agnostic SVG skeleton and keyframe animation authoring tool built on Hexframe's rig model.",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:plan-queue": "node scripts/check-portfolio-contract.mjs",
    "test:github-settings": "node --test tests/contracts/github-settings.test.mjs",
    "check": "npm run test:plan-queue && npm run check:workflow-shell && npm run check:vendor && npm run check:repository && npm run test:contracts && npm run typecheck && npm run test && npm run build -- --mode placeholder && npm run check:change",
    "check:gate": "node scripts/check-portfolio-contract.mjs && npm run check:workflow-shell && npm run check:vendor && npm run check:repository && npm run typecheck && npm run build -- --mode placeholder",
    "check:change": "node scripts/check-change.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:patch": "node scripts/check-patch.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:library": "node scripts/check-library.mjs",
    "check:workflow-shell": "node scripts/check-workflow-shell.mjs",
    "vendor:hexframe": "node scripts/vendor-hexframe.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "verify:github-settings": "node scripts/verify-github-repository-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-repository-settings.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
